# Environments
venv/
.venv/
env/
.env

# Generated data (regenerate with: python -m src.data.build)
data/processed/
.pytest_cache/

# Generated model artifacts (regenerate with: python -m src.models.train)
# models/production/ is committed: the deployed app needs it at runtime and
# can't regenerate Kaggle-credentialed data at deploy time.
/models/*
!/models/production/
.ipynb_checkpoints/

# Streamlit secrets (VERY IMPORTANT - Do not remove this)
.streamlit/secrets.toml

# Python cache
__pycache__/
*.pyc

# OS generated files
.DS_Store